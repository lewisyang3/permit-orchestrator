{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sse_done_event.schema.json",
  "title": "StreamDonePayload",
  "description": "Payload streamed in SSE event: done upon permit consensus resolution",
  "type": "object",
  "required": ["permit_id", "final_decision"],
  "properties": {
    "permit_id": {
      "type": "string"
    },
    "final_decision": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED"]
    }
  }
}
