{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "department_response.schema.json",
  "title": "DepartmentEvaluationResponse",
  "description": "Response returned by each Department microservice (Person B) to Orchestrator (Person A) on POST /evaluate",
  "type": "object",
  "required": [
    "permit_id",
    "department",
    "status",
    "execution_time_ms",
    "reasons",
    "evaluated_at"
  ],
  "properties": {
    "permit_id": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "enum": ["zoning", "fire", "water", "structural"]
    },
    "jurisdiction_id": {
      "type": ["string", "null"],
      "description": "City rule pack the permit was evaluated against, e.g. ca-san-jose"
    },
    "rule_set_id": {
      "type": ["string", "null"],
      "description": "rule_set_id of that department pack"
    },
    "status": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED"],
      "description": "Verdict from this department"
    },
    "execution_time_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Internal rule evaluation latency inside the department microservice"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_name", "passed", "message"],
        "properties": {
          "rule_id": { "type": "string", "description": "e.g. FIRE-001 or ZONE-102" },
          "rule_name": { "type": "string" },
          "passed": { "type": "boolean" },
          "severity": { "type": "string", "enum": ["VIOLATION", "ADVISORY", "INFO"] },
          "message": { "type": "string", "description": "Explanation of rule evaluation" },
          "evidence": {
            "type": "array",
            "description": "What the applicant's document says for the fields this rule checked",
            "items": { "$ref": "permit.schema.json#/definitions/EvidenceSpan" }
          },
          "rule_sources": {
            "type": "array",
            "description": "City sources the rule cites (url, section, printed_page, ...)",
            "items": { "type": "object" }
          }
        }
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
